# 设备端脚本必须是 LF：Windows 下若被 Git 转成 CRLF，
# adb push 到 Linux 后执行会报 "^M: not found" / "syntax error near unexpected token"。
* text=auto

# 类 Unix 侧脚本与配置：仓库与工作副本都强制 LF
*.sh          text eol=lf
*.py          text eol=lf
*.md          text eol=lf
*.conf        text eol=lf
*.pro         text eol=lf
*.qrc         text eol=lf
Makefile      text eol=lf
Makefile.*    text eol=lf
LICENSE       text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# 无扩展名但同样是设备端 shell 脚本
S98_e1linux       text eol=lf
SogouE1.dispatch  text eol=lf
e1_slot_b_marker  text eol=lf

# Windows 侧脚本保持 CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二进制不做换行转换
*.png  binary
